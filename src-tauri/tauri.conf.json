{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Onza Liquidity Tracker",
  "version": "1.1.0",
  "identifier": "com.onza.liquidity-tracker",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Onza Liquidity Tracker",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/rishabh2300/Liquidity-Tracker/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVBMzVDM0M2NUYyRDE2NjEKUldSaEZpMWZ4c00xV29Gd3drV0hMNWpnMmptcVFrSXhNclJCcTRxSEVKWlpYOEVHQXhscXlWWmYK"
    }
  }
}
